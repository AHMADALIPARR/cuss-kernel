; hello.cuss - print "CUSS!" then halt
        movi r1, 67      ; 'C'
        out r1
        movi r1, 85      ; 'U'
        out r1
        movi r1, 83      ; 'S'
        out r1
        movi r1, 83      ; 'S'
        out r1
        movi r1, 33      ; '!'
        out r1
        movi r1, 10      ; '\n'
        out r1
        hlt
